#!/usr/bin/env bash

## Description: Probe YouTube and Vimeo endpoints from an environment
## Usage: sourcecheck
## Example: "ddev sourcecheck prod", "ddev sourcecheck dev", or "ddev sourcecheck local"

set -e

cd "$DDEV_APPROOT" || exit

# Colors
red='\033[0;31m'
yellow='\033[1;33m'
green='\033[0;32m'
NC='\033[0m'

# Clean up secrets on exit or interrupt. The local mode never creates a
# key file, and a failed test here would become the script's exit status.
cleanup() {
  if [ -n "$SSH_KEY_FILE" ]; then
    rm -f "$SSH_KEY_FILE"
  fi
}
trap cleanup EXIT

# Validate environment argument
if [ -z "$1" ] || { [ "$1" != "prod" ] && [ "$1" != "dev" ] && [ "$1" != "local" ]; }; then
  echo -e "${yellow}Specify an environment: ddev sourcecheck prod${NC}"
  echo -e "${yellow}                        ddev sourcecheck dev${NC}"
  echo -e "${yellow}                        ddev sourcecheck local${NC}"
  exit 1
fi

ENV="$1"

# Set environment-specific values
if [ "$ENV" == "prod" ]; then
  OP_ENV="production"
  REMOTE_HOST="bmxfeed.com"
  ENV_FILE="/home/bmxfeed/aggro/current/.env"
elif [ "$ENV" == "dev" ]; then
  OP_ENV="development"
  REMOTE_HOST="dev.bmxfeed.com"
  ENV_FILE="/home/bmxfeed/aggro-dev/current/.env"
else
  ENV_FILE="/var/www/html/.env"
fi

# The same probe runs in every environment so results can be compared
# side by side. Paths are as seen from inside the web container.
PROBE=".ddev/scripts/sourcecheck-probe.sh"
RESULT=0

if [ "$ENV" == "local" ]; then
  echo -e "${yellow}Probing video sources from the local web container...${NC}"
  ddev exec bash "$PROBE" "$ENV_FILE" || RESULT=$?
else
  # Require 1Password CLI
  if ! command -v op &>/dev/null; then
    echo -e "${red}1Password CLI (op) is required but not found.${NC}"
    exit 1
  fi

  # Load SSH key from 1Password into the DDEV container
  OP_VAULT_ITEM="op://Aggro/${OP_ENV}/SSH_PRIVATE_KEY"
  SSH_KEY_FILE=$(mktemp)
  if op read "$OP_VAULT_ITEM" > "$SSH_KEY_FILE" 2>/dev/null; then
    chmod 600 "$SSH_KEY_FILE"
    docker cp "$SSH_KEY_FILE" "ddev-${DDEV_SITENAME}-web:/tmp/op_ssh_key"
    ddev exec bash -c "chmod 600 /tmp/op_ssh_key && ssh-add /tmp/op_ssh_key && rm -f /tmp/op_ssh_key"
  else
    echo -e "${red}Failed to read SSH key from 1Password.${NC}"
    exit 1
  fi
  rm -f "$SSH_KEY_FILE"

  # Stream the probe to the remote shell so nothing is copied to the host
  echo -e "${yellow}Probing video sources from ${REMOTE_HOST}...${NC}"
  ddev exec bash -c "ssh -o StrictHostKeyChecking=accept-new bmxfeed@${REMOTE_HOST} 'bash -s ${ENV_FILE}' < ${PROBE}" || RESULT=$?
fi

if [ "$RESULT" -ne 0 ]; then
  echo -e "\n${red}Some video sources are not reachable from ${ENV}.${NC}"
  exit 1
fi

echo -e "\n${green}All video sources reachable from ${ENV}.${NC}"
